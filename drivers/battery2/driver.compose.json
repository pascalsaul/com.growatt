{
  "$extends": [
    "growatt_v2"
  ],
  "name": {
    "en": "Battery",
    "nl": "Batterij",
    "da": "Batteri",
    "de": "Batterie",
    "es": "Batería",
    "fr": "Batterie",
    "it": "Batteria",
    "no": "Batteri",
    "sv": "Batteri",
    "pl": "Bateria",
    "ru": "Батарея",
    "ko": "배터리",
    "ar": "بطارية"
  },
  "class": "battery",
  "capabilities": [
    "measure_power",
    "measure_battery",
    "battery_charging_state",
    "alarm_battery_charge_forbidden",
    "alarm_battery_discharge_forbidden",
    "alarm_bms_error",
    "measure_battery_cycles",
    "measure_current_battery",
    "measure_current_charge_limit",
    "measure_current_discharge_limit",
    "measure_temperature_bms",
    "measure_temperature_cell_max",
    "measure_temperature_cell_min",
    "measure_voltage_battery",
    "measure_voltage_cell_delta",
    "measure_voltage_cell_max",
    "measure_voltage_cell_min"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "decimals": 0
    },
    "meter_power.charged": {
      "title": {
        "en": "Charged energy",
        "nl": "Geladen energie",
        "da": "Opladet energi",
        "de": "Geladene Energie",
        "es": "Energía cargada",
        "fr": "Énergie chargée",
        "it": "Energia caricata",
        "no": "Ladet energi",
        "sv": "Laddad energi",
        "pl": "Pobrana energia",
        "ru": "Заряженная энергия",
        "ko": "충전된 에너지",
        "ar": "الطاقة المشحونة"
      },
      "decimals": 2
    },
    "meter_power.discharged": {
      "title": {
        "en": "Discharged energy",
        "nl": "Ontladen energie",
        "da": "Afladet energi",
        "de": "Entladene Energie",
        "es": "Energía descargada",
        "fr": "Énergie déchargée",
        "it": "Energia scaricata",
        "no": "Utladet energi",
        "sv": "Urladdad energi",
        "pl": "Oddana energia",
        "ru": "Разряженная энергия",
        "ko": "방전된 에너지",
        "ar": "الطاقة المفرغة"
      },
      "decimals": 2
    }
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "platforms": [
    "local",
    "cloud"
  ],
  "connectivity": [
    "cloud"
  ],
  "images": {
    "small": "{{driverAssetsPath}}/images/small.png",
    "large": "{{driverAssetsPath}}/images/large.png",
    "xlarge": "{{driverAssetsPath}}/images/xlarge.png"
  }
}
